	"editor.semanticTokenColorCustomizations": {
		"rules": {
			"class": "#ffbf80",
			"function": "#ff8080",
			"method": "#ff8080",
			"string": "#ff80bf",
			"constant": "#bdbdff",
			"recordClass": "#eda65e",
			"controlKeyword": "#ff80ff",
			"punctuation": "#467cb9",
			"operator": "#467cb9",
			"comment": "#752e9e",
			"macro": "#4c1e67",
			"xmlDocCommentText": "#752e9e",
			"xmlDocCommentName": "#752e9e",
			"xmlDocCommentDelimiter": "#752e9e",
			"xmlDocCommentAttributeName": "#752e9e",
			"xmlDocCommentAttributeQuotes": "#752e9e",
			"xmlDocCommentAttributeValue": "#752e9e",
			"xmlDocCommentProcessingInstruction": "#752e9e",
			"xmlDocCommentCDataSection": "#752e9e",
			"xmlDocCommentComment": "#752e9e",
			"xmlDocCommentEntityReference": "#752e9e",
			"keyword": "#467cb9",
			"number": "#d19a64",
			"variable": "#bdbdff",
			"delegate": "#ff9999",
			"interface": "#80ff80",
			"enum": "#ffff80",
			"enumMember": "#bdbdff",
			"struct": "#bfff80",
			"namespace": "#ffbf80",
			"property": "#80bfff",
			"parameter": "#bdbdff",
			"*.deprecated": "#4c1e67",
